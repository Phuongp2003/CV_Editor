{
  "name": "cv-editor-share-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute cv-editor-shares --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute cv-editor-shares --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261128.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
