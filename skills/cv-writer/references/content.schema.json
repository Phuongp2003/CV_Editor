{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fynx CV content",
  "type": "object",
  "required": ["cv"],
  "properties": {
    "cv": {
      "type": "object",
      "required": ["name", "email", "phone", "experiences", "projects", "skills", "educations", "certificates"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "summary": { "type": "string" },
        "objective": { "type": "string" },
        "experiences": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
        "projectIntro": { "type": "string" },
        "skills": { "type": "array" },
        "educations": { "type": "array" },
        "certificates": { "type": "array" },
        "customSections": { "type": "array", "items": { "$ref": "#/$defs/customSection" } }
      }
    },
    "coverLetter": { "type": "object" },
    "layout": {
      "type": "object",
      "properties": {
        "sectionsOrder": { "type": "array", "description": "Ordered built-in and custom sections; may contain the layout-only page-break marker once.", "items": { "type": "string" } },
        "disabledSections": { "type": "array", "items": { "type": "string" } },
        "sectionLabels": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bullet": { "type": "object", "required": ["type", "text"], "properties": { "id": { "type": "string" }, "type": { "enum": ["header", "l1", "l2", "l3"] }, "text": { "type": "string" } } },
    "entry": { "type": "object", "required": ["position", "company", "dates", "bullets"], "properties": { "position": { "type": "string" }, "company": { "type": "string" }, "location": { "type": "string" }, "dates": { "type": "string" }, "bullets": { "type": "array", "items": { "$ref": "#/$defs/bullet" } } } },
    "project": { "type": "object", "required": ["projectName", "overview", "bullets"], "properties": { "projectName": { "type": "string" }, "projectLink": { "type": "string" }, "overview": { "type": "string", "description": "Real project context: product/system, domain, users, purpose and verified scale or scope; keep candidate contributions in bullets." }, "dates": { "type": "string", "description": "Verified project activity period, used for reverse-chronological ordering." }, "technologies": { "type": "string", "description": "Concise relevant stack, rendered as a Technologies bullet before contribution bullets." }, "bullets": { "type": "array", "items": { "$ref": "#/$defs/bullet" } } } },
    "customEntry": { "type": "object", "properties": { "position": { "type": "string" }, "positionDates": { "type": "string" }, "company": { "type": "string" }, "location": { "type": "string" }, "dates": { "type": "string" }, "bullets": { "type": "array", "items": { "$ref": "#/$defs/bullet" } } } },
    "customSkill": { "type": "object", "required": ["skill", "description"], "properties": { "skill": { "type": "string" }, "description": { "type": "string" } } },
    "customSection": {
      "type": "object",
      "required": ["id", "title", "entries"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "title": { "type": "string", "description": "Visible H1 section heading." },
        "preset": { "enum": ["summary", "experience", "skills"], "default": "experience" },
        "experienceStyle": { "enum": ["inherit", "hierarchy", "classic", "role-company", "one-line"], "description": "hierarchy always uses company as H2 and optionally shows job title as H3." },
        "showCompanyDates": { "type": "boolean", "default": true },
        "showPosition": { "type": "boolean", "default": false },
        "showPositionDates": { "type": "boolean", "default": false },
        "summaryText": { "type": "string" },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/customSkill" } },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/customEntry" } }
      }
    }
  }
}
